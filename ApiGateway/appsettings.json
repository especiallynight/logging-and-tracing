{
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "projects-route": {
        "ClusterId": "projects-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "tasks-route": {
        "ClusterId": "tasks-cluster",
        "Match": {
          "Path": "/api/tasks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users": { "Address": "http://localhost:5135/" }
        }
      },
      "projects-cluster": {
        "Destinations": {
          "projects": { "Address": "http://localhost:5206/" }
        }
      },
      "tasks-cluster": {
        "Destinations": {
          "tasks": { "Address": "http://localhost:5221/" }
        }
      }
    }
  }
}
{
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users": {
            "Address": "https://localhost:5001/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "https://localhost:5002/"
          }
        }
      }
    }
  }
}
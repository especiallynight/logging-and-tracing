{
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "task-route": {
        "ClusterId": "task-cluster",
        "Match": {
          "Path": "/api/tasks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://localhost:5135/"
          }
        }
      },
      "project-cluster": {
        "Destinations": {
          "project-service": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "task-cluster": {
        "Destinations": {
          "task-service": {
            "Address": "http://localhost:5221/"
          }
        }
      }
    }
  }
}